{
  "id": "./",
  "name": "Mosaïque — budget et dépenses",
  "short_name": "Mosaïque",
  "description": "Suivi de budget et de dépenses personnel : comptes, enveloppes, transactions récurrentes. Vos données restent sur votre appareil.",
  "lang": "fr-FR",
  "dir": "ltr",
  "start_url": "./accueil",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#07080C",
  "theme_color": "#07080C",
  "categories": ["finance", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    {
      "src": "icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Nouvelle transaction",
      "short_name": "Ajouter",
      "description": "Saisir une dépense, un revenu ou un virement",
      "url": "./transactions?ajout=1",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Transactions",
      "url": "./transactions",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Budget",
      "url": "./budget",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
